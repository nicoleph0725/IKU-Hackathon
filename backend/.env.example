# Copy to .env and fill in. NEVER commit .env.

# --- Database ---------------------------------------------------------------
# Local Docker (docker compose up -d):
DATABASE_URL=postgresql://studycafe:studycafe@localhost:5432/studycafe
# Tiger Cloud (copy the service connection string from the Tiger Cloud console):
# DATABASE_URL=postgresql://tsdbadmin:<password>@<service-id>.<project>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require

# Used by pytest only. Must be a separate database: tests wipe it.
TEST_DATABASE_URL=postgresql://studycafe:studycafe@localhost:5432/studycafe_test

# --- Auth -------------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12

# --- App --------------------------------------------------------------------
FLASK_DEBUG=1
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174
