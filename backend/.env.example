# Copy this file to .env and fill in the values. Never commit .env.
FLASK_DEBUG=1
SECRET_KEY=change-me

# Google Maps JavaScript API key (Google Cloud Console -> APIs & Services -> Credentials)
MAP_KEY=

# Google Maps Map ID with our map style (Google Cloud Console -> Google Maps Platform -> Map Management).
# Optional: without it the map uses Google's unstyled DEMO_MAP_ID.
MAP_ID=
GEMINI_KEY=
